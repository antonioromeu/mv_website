---
import { adContent } from '../../content/assistant_director';

interface Props {
    lang: 'en' | 'pt';
}

const { lang } = Astro.props;
const t = adContent[lang];

// Frontmatter Helper: Chunk credits array into pages
const chunkArray = <T,>(arr: T[], size: number): T[][] =>
    Array.from({ length: Math.ceil(arr.length / size) }, (_, i) => arr.slice(i * size, i * size + size));

// 1. Mobile Chunking (4 per page)
const mobilePages = chunkArray(t.credits, 4);

// 2. Desktop Chunking (20 per page - fits 4 columns x 5 rows)
const desktopPages = chunkArray(t.credits, 20);

const byLabel = lang === 'pt' ? 'de' : 'by';
---

<section 
    id="assistant-director" 
    data-color="var(--color-blue)" 
    class="snap-section shrink-0"
    style={`padding-top: var(--nav-height);`}
>
    <!-- ================= MOBILE VIEW ================= -->
    <div class="flex flex-col w-full h-full overflow-hidden md:hidden">
        <!-- Header -->
        <div class="w-full px-[3.5vw] pt-[6vh] pb-[1vh]">
            <div class="border-b border-current pb-[1vh]">
                <span class="block text-xs font-bold">{t.title}</span>
            </div>
        </div>
        
        <!-- Mobile Scrollable Pages -->
        <div class="flex-1 overflow-x-auto snap-x snap-mandatory hide-scrollbar flex"
            id="assistant-scroll-mobile">
            {mobilePages.map((page, pageIdx) => (
                <div class="w-full h-full snap-start flex px-[3.5vw] shrink-0 ad-page-mobile" data-page-index={pageIdx}>
                    <div class="text-[10px] leading-relaxed space-y-[1vh]">
                        {page.map(item => (
                            <div>
                                {item.link ? (
                                    <>
                                        <a href={item.link} target="_blank" class="hover:underline"><strong>{item.title}</strong></a>
                                        {item.status && <span> {item.status}</span>}
                                    </>
                                ) : (
                                    <>
                                        <strong>{item.title}</strong>
                                        {item.status && <span> {item.status}</span>}
                                    </>
                                )}
                                <br />{byLabel} {item.director}
                                <br />{item.type}
                                <br />{item.production}
                                <br />{item.role}
                                <br />{item.date}
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>

        <!-- Mobile Page Indicators -->
        {mobilePages.length > 1 && (
            <div class="flex justify-center gap-2 py-[2vh] shrink-0">
                {mobilePages.map((_, i) => (
                    <div 
                        class={`page-indicator-ad-mobile w-1.5 h-1.5 rounded-full bg-current transition-opacity duration-200 pointer-events-none ${i === 0 ? 'opacity-100' : 'opacity-30'}`}
                    ></div>
                ))}
            </div>
        )}
    </div>

    <!-- ================= DESKTOP VIEW ================= -->
    <div class="hidden flex-col w-full h-full pt-[3vh] px-[3.5vw] md:flex">
        <!-- Header -->
        <div class="w-full border-b border-current pb-2 mb-3">
            <span class="block font-bold xl:text-base 2xl:text-lg">
                {t.title}
            </span>
        </div>

        <!-- Desktop Scrollable Pages Container -->
        <div class="flex-1 overflow-x-auto snap-x snap-mandatory hide-scrollbar flex w-full" id="assistant-scroll-desktop">
            {desktopPages.map((page, pageIdx) => (
                <div class="w-full h-full snap-start shrink-0 ad-page-desktop" data-page-index={pageIdx}>
                    <div class="columns-4 gap-8 leading-relaxed xl:text-2xs 2xl:text-xs">
                        {page.map(item => (
                            <div class="break-inside-avoid xl:mb-3 2xl:mb-4">
                                {item.link ? (
                                    <>
                                        <a href={item.link} target="_blank" class="hover:underline"><strong>{item.title}</strong></a>
                                        {item.status && <span> {item.status}</span>}
                                    </>
                                ) : (
                                    <>
                                        <strong>{item.title}</strong>
                                        {item.status && <span> {item.status}</span>}
                                    </>
                                )}
                                <br />{byLabel} {item.director}
                                <br />{item.type}
                                <br />{item.production}
                                <br />{item.role}
                                <br />{item.date}
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>

        <!-- Desktop Page Indicators -->
        {desktopPages.length > 1 && (
            <div class="flex justify-center gap-2 pt-4 pb-4 shrink-0">
                {desktopPages.map((_, i) => (
                    <div 
                        class={`page-indicator-ad-desktop w-2 h-2 rounded-full bg-current transition-opacity duration-200 pointer-events-none ${i === 0 ? 'opacity-100' : 'opacity-30'}`} 
                    ></div>
                ))}
            </div>
        )}
    </div>
</section>

<script>
    function initAD() {
        // Read-only IntersectionObserver pagination sync (glows on swipe/scroll)
        function setupReadonlyPagination(containerId: string, pageClass: string, dotClass: string) {
            const container = document.getElementById(containerId);
            const pages = container?.querySelectorAll(`.${pageClass}`);
            const dots = document.querySelectorAll(`.${dotClass}`);

            if (!container || !pages || pages.length === 0 || dots.length === 0) return;

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const activeIdx = Number((entry.target as HTMLElement).dataset.pageIndex);
                        dots.forEach((dot, idx) => {
                            dot.classList.toggle('opacity-100', idx === activeIdx);
                            dot.classList.toggle('opacity-30', idx !== activeIdx);
                        });
                    }
                });
            }, {
                root: container,
                threshold: 0.6
            });

            pages.forEach(page => observer.observe(page));
        }

        // Initialize mobile and desktop observers
        setupReadonlyPagination('assistant-scroll-mobile', 'ad-page-mobile', 'page-indicator-ad-mobile');
        setupReadonlyPagination('assistant-scroll-desktop', 'ad-page-desktop', 'page-indicator-ad-desktop');

        // Mobile Double Tap Logic
        const doubleTapLinks = document.querySelectorAll('.mobile-double-tap');
        doubleTapLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                if (window.innerWidth < 768) {
                    const el = e.currentTarget as HTMLElement;
                    if (!el.classList.contains('active-link')) {
                        e.preventDefault();
                        doubleTapLinks.forEach(l => l.classList.remove('active-link', 'underline'));
                        el.classList.add('active-link', 'underline');
                    }
                }
            });
        });

        // Reset active links when clicking elsewhere
        document.addEventListener('click', (e) => {
            if (!(e.target as HTMLElement).closest('.mobile-double-tap')) {
                doubleTapLinks.forEach(l => l.classList.remove('active-link', 'underline'));
            }
        });
    }

    // Initialize on first mount & Astro View Transitions
    initAD();
    document.addEventListener('astro:page-load', initAD);
</script>